---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found">
  <section class="section nf">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="display h1">This floor does not exist.</h1>
      <a class="btn btn--ink" href="/">Back to ground floor <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf .wrap {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  h1 {
    max-width: 12ch;
  }
</style>
