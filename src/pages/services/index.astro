---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import Accordion from '../../components/Accordion.astro';
import CTA from '../../components/CTA.astro';
import { services, generalFaqs } from '../../data/services';
---

<BaseLayout title="Services" description="Rope access, BMU and gondola, post-construction and villa façade cleaning in the UAE.">
  <PageHeader
    eyebrow="Services"
    title="Pick by height and access."
    lead="The right method depends on how tall the building is and what is already installed on the roof."
  />

  <section class="section--tight">
    <div class="wrap list">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class:list={['row', 'reveal', { flip: i % 2 }]}>
          <Media spec={s.hero} index={i} alt={s.title} class="img" fallback="#0e3345" />
          <div class="txt">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} · {s.height}</p>
            <h2 class="display h3">{s.title}</h2>
            <p class="muted">{s.bestFor}</p>
            <span class="link-arrow">Details <Icon name="arrow-right" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section on-mist">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Common questions</p>
        <h2 class="display h2">Before you ask.</h2>
      </div>
      <div class="reveal" style="--d:100ms"><Accordion items={generalFaqs} /></div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--space-6);
  }
  .row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .row.flip .img {
    order: 2;
  }
  .img {
    aspect-ratio: 4 / 3;
    transition: transform 0.6s var(--ease);
  }
  .row:hover .img {
    transform: scale(1.015);
  }
  .txt {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .row.flip .img {
      order: 0;
    }
  }
</style>
