---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../data/site';
---

<BaseLayout title="Contact" description="Send us your building details on WhatsApp or call. We reply the same working day.">
  <PageHeader eyebrow="Contact" title="Tell us the building." lead="The form opens WhatsApp with your details filled in." />

  <!-- 1. Form + direct -->
  <section class="section">
    <div class="wrap grid-2">
      <form data-wa={site.phoneIntl} class="form reveal">
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Building name<input name="building" /></label>
        <div class="two">
          <label>Floors<input name="floors" inputmode="numeric" /></label>
          <label>Area<input name="area" placeholder="e.g. Business Bay" /></label>
        </div>
        <label>Notes<textarea name="message" rows="4"></textarea></label>
        <button class="btn btn--ink" type="submit">Send on WhatsApp <Icon name="arrow-right" /></button>
      </form>

      <div class="direct reveal" style="--d:100ms">
        <a href={whatsappLink()} target="_blank" rel="noopener" class="big display">{site.phoneDisplay}</a>
        <div class="acts">
          <a class="btn btn--line" href={`tel:+${site.phoneIntl}`}><Icon name="phone" /> Call</a>
          <a class="btn btn--line" href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Location + hours -->
  <section class="section on-mist">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Office</p>
        <h2 class="display h2">Business Bay, Dubai.</h2>
        <p class="muted lead">{site.address}</p>
        <a class="link-arrow" target="_blank" rel="noopener" href={`https://www.google.com/maps/search/${encodeURIComponent(site.mapQuery)}`}>
          Open in Maps <Icon name="arrow-right" />
        </a>
      </div>
      <div class="reveal" style="--d:100ms">
        <p class="eyebrow">Hours</p>
        <ul class="hours">
          {site.hours.map((h) => (
            <li><span>{h.day}</span><strong>{h.time}</strong></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form {
    display: grid;
    gap: var(--space-2);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 500;
  }
  input,
  textarea {
    font: inherit;
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule);
    background: var(--white);
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--teal);
    border-color: var(--teal);
  }
  .form .btn {
    justify-self: start;
  }
  .direct {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    border-left: 1px solid var(--rule);
    padding-left: var(--space-5);
  }
  .big {
    font-size: var(--step-3);
    border-bottom: 2px solid var(--accent);
    justify-self: start;
  }
  .acts {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .acts :global(svg) {
    width: 1rem;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
    margin-top: 0;
  }
  .grid-2 .lead {
    margin-block: var(--space-2) var(--space-3);
  }
  h2 {
    margin-top: var(--space-1);
  }
  @media (max-width: 860px) {
    .direct {
      border: 0;
      padding: 0;
    }
  }
</style>
