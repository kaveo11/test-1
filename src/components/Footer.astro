---
import Logo from './Logo.astro';
import { services } from '../data/services';
import { site, nav, whatsappLink } from '../data/site';
---

<footer class="on-ink foot">
  <div class="wrap">
    <div class="logo-row"><Logo height={110} tone="light" /></div>
    <div class="cols">
      <div>
        <h3 class="eyebrow">Services</h3>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="eyebrow">Company</h3>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="eyebrow">Contact</h3>
        <ul>
          <li><a href={whatsappLink()} target="_blank" rel="noopener">{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted">{site.address}</li>
        </ul>
      </div>
    </div>
    <hr class="rule" />
    <div class="legal muted">
      <span>© {new Date().getFullYear()} {site.legal}. Sample project: names, figures and testimonials are placeholders.</span>
      <span>Photos and video from <a href="https://www.pexels.com" target="_blank" rel="noopener">Pexels</a>.</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--space-6) var(--space-4);
  }
  .logo-row {
    margin-bottom: var(--space-5);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .cols h3 {
    margin-bottom: var(--space-2);
  }
  .cols li {
    margin-bottom: 0.6rem;
  }
  .cols a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .cols a:hover {
    border-color: var(--accent);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-top: var(--space-3);
    font-size: var(--step--1);
  }
  .legal a {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
