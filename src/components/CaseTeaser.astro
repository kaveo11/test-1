---
import Icon from './Icon.astro';
import { cases } from '../data/content';
---

<section class="section on-deep">
  <div class="wrap">
    <div class="top reveal">
      <div>
        <p class="eyebrow">Case studies</p>
        <h2 class="display h2">Recent projects.</h2>
      </div>
      <a class="link-arrow" href="/case-studies">All projects <Icon name="arrow-right" /></a>
    </div>
    <div class="cards">
      {cases.map((c, i) => (
        <a class="card reveal" href={`/case-studies#${c.slug}`} style={`--d:${i * 100}ms`}>
          <span class="eyebrow">{c.method}</span>
          <strong class="display">{c.facts[0].v}</strong>
          <h3>{c.name}</h3>
          <p class="muted">{c.place} · {c.type}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .top h2 {
    margin-top: var(--space-1);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.2);
  }
  .card {
    background: var(--deep);
    padding: var(--space-4);
    min-height: 340px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    transition: background 0.35s var(--ease);
  }
  .card:hover {
    background: var(--teal);
  }
  .card:hover .muted {
    color: #e3edf1;
  }
  .card strong {
    font-size: var(--step-3);
    font-weight: 400;
    margin-top: auto;
  }
  .card h3 {
    font-weight: 500;
    font-size: var(--step-1);
  }
  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 220px;
    }
  }
</style>
