---
import Media from './Media.astro';
import Icon from './Icon.astro';
import { media } from '../data/media';
import { site, whatsappLink } from '../data/site';
---

<section class="cta">
  <Media spec={media.skyline} index={3} class="media--fill" fallback="#eaf2f5" />
  <div class="overlay overlay--light"></div>
  <div class="wrap in">
    <h2 class="display h2 reveal">Send us the building name and floors.</h2>
    <p class="reveal" style="--d:100ms">We reply the same working day with a survey date.</p>
    <div class="row reveal" style="--d:200ms">
      <a class="btn btn--ink" href={whatsappLink()} target="_blank" rel="noopener">
        WhatsApp {site.phoneDisplay} <Icon name="arrow-right" />
      </a>
      <a class="btn btn--line" href={`tel:+${site.phoneIntl}`}><Icon name="phone" /> Call</a>
      <button class="btn btn--line" data-open-quote>Request a quote</button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7);
  }
  .in {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-3);
  }
  h2 {
    max-width: 16ch;
  }
  .row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .btn--line :global(svg) {
    width: 1rem;
  }
</style>
